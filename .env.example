# Copy this file to .env and fill in your real values.
# .env is gitignored — never commit real API keys.

# Get this from https://resend.com/api-keys
RESEND_API_KEY=

# Where role-inquiry form submissions get emailed to.
CONTACT_TO_EMAIL=

# Must be on a domain you've verified in Resend. Until you verify one,
# leave this as-is — Resend's shared sandbox address works for testing.
RESEND_FROM_EMAIL=StaffBrigade <onboarding@resend.dev>

# Port the backend server listens on.
PORT=3001

# reCAPTCHA v3 site key from https://www.google.com/recaptcha/admin/create
# Public — bundled into the frontend.
VITE_RECAPTCHA_SITE_KEY=

# reCAPTCHA Enterprise createAssessment credentials (console.cloud.google.com/security/recaptcha).
# GOOGLE_CLOUD_PROJECT_ID is the project ID (not display name) the site
# key lives under. RECAPTCHA_API_KEY is an API key restricted to the
# reCAPTCHA Enterprise API, backend-only.
GOOGLE_CLOUD_PROJECT_ID=
RECAPTCHA_API_KEY=

# Calendly enhanced conversions — a Calendly webhook (invitee.created) posts
# to /api/webhooks/calendly whenever someone books a call, and the handler
# forwards the invitee's email + gclid to Google Ads as an enhanced
# conversion. Signing key comes from creating the webhook subscription
# (see scripts/create-calendly-webhook.mjs) — Calendly Standard plan or
# above required for webhook access.
CALENDLY_WEBHOOK_SIGNING_KEY=

# Data Manager API credentials for uploading the Calendly conversions above
# (this replaced the legacy Google Ads API conversion upload endpoint,
# which Google has closed to new integrations — no developer token needed
# here). CLIENT_ID/SECRET come from an OAuth 2.0 Client (Desktop app type)
# in a Google Cloud project with the Data Manager API enabled.
# REFRESH_TOKEN is minted once via scripts/get-google-ads-refresh-token.mjs,
# run by whoever has access to the Ads account below (directly, or via a
# manager account). CUSTOMER_ID is the Ads account number that owns "Book
# appointment" (digits only, no dashes — this is the number shown in the
# account switcher in the Google Ads UI, NOT the "ocid" from the address
# bar, which can differ). CONVERSION_ACTION_ID is the numeric ID of that
# conversion action. LOGIN_CUSTOMER_ID is only needed if CUSTOMER_ID's
# account is managed under a manager (MCC) account — set it to that
# manager account's number.
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_CONVERSION_ACTION_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# Set to "true" to log conversion uploads instead of sending them to Google
# — use this to verify the webhook -> conversion pipeline before spending
# real calls against the production Ads account.
GOOGLE_ADS_DRY_RUN=
